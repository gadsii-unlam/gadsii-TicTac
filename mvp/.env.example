# Copiá este archivo a .env y ajustá los valores antes de `docker compose up -d --build`.

# Puerto donde se publica la web (nginx). Con HTTPS (perfil "https") conviene dejarla solo local: WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
WEB_BIND_ADDRESS=0.0.0.0

# URL de la API para la web. Dejala vacía: la web usa su propio origen y nginx reenvía /api y /media.
# Solo para apps nativas o una API en otro dominio (en ese caso configurá también CORS_ORIGINS).
EXPO_PUBLIC_API_URL=
CORS_ORIGINS=http://localhost:8080

# Puerto de la API solo para uso local (cargador de eventos). No lo abras a internet.
API_PORT=3000
API_BIND_ADDRESS=127.0.0.1

# Clave del cargador de eventos. Vacía = el servidor genera una y la guarda en el volumen.
ADMIN_TOKEN=
# Contacto que reciben los servicios de push. Cambialo por un mail real.
VAPID_SUBJECT=mailto:contact@example.com

# HTTPS automático con `docker compose --profile https up -d --build` (requiere un dominio apuntando a este server).
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
