{
  "name": "nodo-unlam-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "Nodo UNLaM - MVP TP5 del equipo TicTac",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "concurrently --kill-others \"npm:server\" \"npm:mobile\"",
    "dev": "npm start",
    "server": "node src/server/index.js",
    "mobile": "expo start --dev-client",
    "web:expo": "expo start --web",
    "android:expo": "expo start --dev-client --android",
    "ios:expo": "expo start --dev-client --ios",
    "web": "concurrently --kill-others \"npm:server\" \"npm:web:expo\"",
    "android": "concurrently --kill-others \"npm:server\" \"npm:android:expo\"",
    "ios": "concurrently --kill-others \"npm:server\" \"npm:ios:expo\"",
    "test": "node --test tests/*.test.js",
    "demo:event": "node src/server/add-event.js",
    "add:event": "node src/server/add-event.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
